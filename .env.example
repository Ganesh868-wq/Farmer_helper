# ==============================================================
# RYTHU MITRA AI (రైతు మిత్ర AI) - ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure your local settings.
# Never commit your actual .env file or API keys to version control.
# ==============================================================

# Application Settings
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
HOST=127.0.0.1
SECRET_KEY=replace-with-a-secure-random-secret-key-for-session-tokens

# Database Configuration
DATABASE_PATH=rythu_mitra.db

# External AI Service (Google Gemini API)
# Get your free key at https://aistudio.google.com/
# When left empty, Rythu Mitra automatically runs in Local Expert & CV Mode
# and transparently displays that external AI credentials are unconfigured.
GEMINI_API_KEY=

# External Weather Service (OpenWeatherMap API - Optional)
# By default, Rythu Mitra uses Open-Meteo for live real-time forecasts without needing any key.
# If you also want OpenWeather integration, supply your key below:
OPENWEATHER_API_KEY=

# Open Data / Mandi API (data.gov.in - Optional)
# If left empty, Rythu Mitra uses official APMC Mandi & MSP benchmark datasets
DATA_GOV_IN_API_KEY=

# Agricultural Drone Telemetry Security (Optional / Recommended for Field Drones)
# Set a shared secret token to authenticate telemetry ingested from companion computers or tools/drone_bridge.py
DRONE_API_KEY=
# Optional drone gateway or DJI webhook endpoint
DRONE_CONNECTION_ENDPOINT=

